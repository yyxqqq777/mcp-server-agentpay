# Glama / MCP hosting: stdio MCP server (not the HTTP gateway).
# Railway continues to use ./Dockerfile for the x402 gateway.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY pyproject.toml README.md LICENSE ./
COPY src ./src

RUN pip install --no-cache-dir .

# Glama wraps stdio; required at runtime:
#   GATEWAY_BASE_URL, AGENT_PRIVATE_KEY (optional for status tool)
CMD ["mcp-server-agentpay"]
